{
  "name": "formext-formcut-shot-list",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shot List, a FormCut extension: one frame per clip with timecodes, names and notes, saved as a printable PDF or PNG storyboard sheet.",
  "scripts": {
    "check": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && esbuild src/main.ts --bundle --format=esm --target=es2020 --minify --legal-comments=none --outfile=package/ui/shot-list.js",
    "package": "python3 tools/formpkg.py build package -o dist"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
