{
  "name": "formext-formpdf-mail-merge",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=package/ui/mail-merge.js && esbuild src/mail-merge.css --bundle --minify --outfile=package/ui/mail-merge.css",
    "package": "python3 tools/formpkg.py build package -o dist"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
